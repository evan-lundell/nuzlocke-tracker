// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PokemonType {
  NORMAL
  FIRE
  WATER
  ELECTRIC
  GRASS
  ICE
  FIGHTING
  POISON
  GROUND
  FLYING
  PSYCHIC
  BUG
  ROCK
  GHOST
  DRAGON
  DARK
  STEEL
  FAIRY
}

model Game {
  id         String   @id @default(uuid(7))
  identifier String   @unique // slug matching PokeAPI's "version" identifier, e.g. "leaf-green"
  name       String // display name, e.g. "LeafGreen"
  generation Int
  createdAt  DateTime @default(now())

  routes Route[]
  runs   Run[]
}

model Route {
  id         String   @id @default(uuid(7))
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id])
  identifier String // PokeAPI location-area slug
  name       String // e.g. "Route 1"
  order      Int // progression order within the game
  createdAt  DateTime @default(now())

  routeSpecies RouteSpecies[]
  encounters   Encounter[]

  @@unique([gameId, identifier])
}

model Species {
  id            String       @id @default(uuid(7))
  identifier    String       @unique // PokeAPI slug, e.g. "bulbasaur"
  name          String
  pokedexNumber Int
  typePrimary   PokemonType
  typeSecondary PokemonType?

  evolvesFromId   String?
  evolvesFrom     Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo       Species[] @relation("Evolution")
  evolutionMethod String? // "level-up", "trade", "use-item", etc. — how this species evolves from its parent
  evolutionDetail String? // free-form: "level 16", "thunder-stone"

  createdAt DateTime @default(now())

  routeSpecies RouteSpecies[]
  encounters   Encounter[]
}

// The curated "normally found here" list for a Route — not a constraint on
// what a user can actually log as an encounter (randomizer support relies
// on the full Species list remaining searchable independent of this table).
model RouteSpecies {
  id        String  @id @default(uuid(7))
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id])
  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])
  method    String? // PokeAPI encounter method slug, e.g. "walk", "old-rod"

  @@unique([routeId, speciesId, method])
}

model User {
  id          String   @id @default(uuid(7))
  email       String   @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  authAccounts AuthAccount[]
  runs         Run[]
  legacies     Legacy[]
  createdRules Rule[]
}

// Auth identity is split from User so a single account can eventually link
// multiple OAuth providers. Deduped on (provider, providerAccountId), not
// email — some providers don't guarantee a verified/returned email.
model AuthAccount {
  id                String   @id @default(uuid(7))
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String // "google" | "github"
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

enum RunStatus {
  ACTIVE
  FAILED
  COMPLETED
}

enum RuleKind {
  ENFORCED // has real app logic, e.g. type-lock
  INFORMATIONAL // tracking/reminder only, no enforcement
}

// Catalog of rules a Run can opt into. Seeded with built-in rules
// (createdById null); user-authored custom rules (necessarily
// INFORMATIONAL, since enforcement requires real app logic) reuse the same
// table by setting createdById.
model Rule {
  id          String   @id @default(uuid(7))
  key         String?  @unique // stable identifier built-in app logic switches on, e.g. "type-lock"; null for user-authored rules, which have no app logic to hook into and are never referenced by key
  name        String
  description String
  kind        RuleKind
  createdById String? // null = built-in, visible to all users; set = custom rule, visible only to its creator
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  runRules RunRule[]
}

// A Run's selected rules. Legacy mode is a separate axis (Run.legacyId),
// not represented here.
model RunRule {
  id     String @id @default(uuid(7))
  runId  String
  run    Run    @relation(fields: [runId], references: [id])
  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id])
  config Json? // rule-specific settings, e.g. an informational item-limit rule's count

  @@unique([runId, ruleId])
}

model Run {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id])
  legacyId  String?
  legacy    Legacy?   @relation(fields: [legacyId], references: [id])
  status    RunStatus @default(ACTIVE)
  name      String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  encounters       Encounter[]
  partyMemberships PartyMembership[]
  runRules         RunRule[]
}

// Groups a chain of Runs on the same Game where a failed run hands off to a
// successor (with carried-over points and, by default, the same rules).
// Deliberately has no gameId of its own — every run in the chain shares one
// by construction, not by a denormalized/enforced field.
model Legacy {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  points    Int      @default(0) // denormalized cache of the sum of pointTransactions.amount
  createdAt DateTime @default(now())

  runs              Run[]
  pointTransactions LegacyPointTransaction[]
}

// Source-of-truth audit log backing Legacy.points. Point values per action
// aren't final yet, so a ledger keeps re-tuning them low-risk and makes
// "why do I have N points" answerable.
model LegacyPointTransaction {
  id        String   @id @default(uuid(7))
  legacyId  String
  legacy    Legacy   @relation(fields: [legacyId], references: [id])
  runId     String? // which run in the chain earned/spent it
  amount    Int // positive = earned, negative = spent
  reason    String // "catch", "gym-win", "rival-win", "reencounter", "resurrect"
  createdAt DateTime @default(now())
}

enum VitalStatus {
  ALIVE
  DEAD
}

// One row per encounter opportunity a user logs for a run. Usually one per
// route, but @@unique includes label so users can add extra ad hoc
// encounters to the same route (e.g. a static Snorlax tracked separately
// from the route's wild encounter).
model Encounter {
  id          String       @id @default(uuid(7))
  runId       String
  run         Run          @relation(fields: [runId], references: [id])
  routeId     String
  route       Route        @relation(fields: [routeId], references: [id])
  speciesId   String?
  species     Species?     @relation(fields: [speciesId], references: [id])
  label       String       @default("Wild Encounter")
  order       Float
  caught      Boolean      @default(false)
  nickname    String?
  vitalStatus VitalStatus?
  lockedType  PokemonType? // type-lock rule: chosen at catch time for dual-typed species, permanent thereafter
  createdAt   DateTime     @default(now())

  partyMembership PartyMembership?

  @@unique([runId, routeId, label])
}

// Existence of a row = the encounter's Pokemon is currently in the active
// party. Absence = boxed. Kept separate from Encounter so "what happened"
// (stable log) and "what's on my team right now" (frequently mutated) don't
// share a table.
model PartyMembership {
  id          String    @id @default(uuid(7))
  runId       String
  run         Run       @relation(fields: [runId], references: [id])
  encounterId String    @unique
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  createdAt   DateTime  @default(now())
}
