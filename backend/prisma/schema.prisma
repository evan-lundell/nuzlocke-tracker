// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PokemonType {
  NORMAL
  FIRE
  WATER
  ELECTRIC
  GRASS
  ICE
  FIGHTING
  POISON
  GROUND
  FLYING
  PSYCHIC
  BUG
  ROCK
  GHOST
  DRAGON
  DARK
  STEEL
  FAIRY

  @@map("pokemon_type")
}

model Game {
  id         String   @id @default(uuid(7))
  identifier String   @unique // slug matching PokeAPI's "version" identifier, e.g. "leafgreen"
  name       String // display name, e.g. "LeafGreen"
  generation Int
  createdAt  DateTime @default(now()) @map("created_at")

  routes Route[]
  runs   Run[]

  @@map("games")
}

model Route {
  id         String   @id @default(uuid(7))
  gameId     String   @map("game_id")
  game       Game     @relation(fields: [gameId], references: [id])
  identifier String // PokeAPI location slug (not location-area — the game shows one banner per location regardless of floor/sub-area, matching nuzlocke convention of one encounter per named area)
  name       String // e.g. "Route 1"
  order      Int // progression order within the game
  createdAt  DateTime @default(now()) @map("created_at")

  routeSpecies RouteSpecies[]
  encounters   Encounter[]

  @@unique([gameId, identifier])
  @@map("routes")
}

model Species {
  id            String       @id @default(uuid(7))
  identifier    String       @unique // PokeAPI slug, e.g. "bulbasaur"
  name          String
  pokedexNumber Int          @map("pokedex_number")
  typePrimary   PokemonType  @map("type_primary")
  typeSecondary PokemonType? @map("type_secondary")

  evolvesFromId   String?   @map("evolves_from_id")
  evolvesFrom     Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo       Species[] @relation("Evolution")
  evolutionMethod String?   @map("evolution_method") // "level-up", "trade", "use-item", etc. — how this species evolves from its parent
  evolutionDetail String?   @map("evolution_detail") // free-form: "level 16", "thunder-stone"

  createdAt DateTime @default(now()) @map("created_at")

  routeSpecies RouteSpecies[]
  encounters   Encounter[]

  @@map("species")
}

// The curated "normally found here" list for a Route — not a constraint on
// what a user can actually log as an encounter (randomizer support relies
// on the full Species list remaining searchable independent of this table).
model RouteSpecies {
  id        String  @id @default(uuid(7))
  routeId   String  @map("route_id")
  route     Route   @relation(fields: [routeId], references: [id])
  speciesId String  @map("species_id")
  species   Species @relation(fields: [speciesId], references: [id])
  method    String? // PokeAPI encounter method slug, e.g. "walk", "old-rod"

  @@unique([routeId, speciesId, method])
  @@map("route_species")
}

model User {
  id          String   @id @default(uuid(7))
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")

  authAccounts AuthAccount[]
  runs         Run[]
  legacies     Legacy[]
  createdRules Rule[]

  @@map("users")
}

// Auth identity is split from User so a single account can eventually link
// multiple OAuth providers. Deduped on (provider, providerAccountId), not
// email — some providers don't guarantee a verified/returned email.
model AuthAccount {
  id                String   @id @default(uuid(7))
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  provider          String // "google" | "github"
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

enum RunStatus {
  ACTIVE
  FAILED
  COMPLETED

  @@map("run_status")
}

enum RuleKind {
  ENFORCED // has real app logic, e.g. type-lock
  INFORMATIONAL // tracking/reminder only, no enforcement

  @@map("rule_kind")
}

// Catalog of rules a Run can opt into. Seeded with built-in rules
// (createdById null); user-authored custom rules (necessarily
// INFORMATIONAL, since enforcement requires real app logic) reuse the same
// table by setting createdById.
model Rule {
  id          String   @id @default(uuid(7))
  key         String?  @unique // stable identifier built-in app logic switches on, e.g. "type-lock"; null for user-authored rules, which have no app logic to hook into and are never referenced by key
  name        String
  description String
  kind        RuleKind
  createdById String?  @map("created_by_id") // null = built-in, visible to all users; set = custom rule, visible only to its creator
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  runRules RunRule[]

  @@map("rules")
}

// A Run's selected rules. Legacy mode is a separate axis (Run.legacyId),
// not represented here.
model RunRule {
  id     String @id @default(uuid(7))
  runId  String @map("run_id")
  run    Run    @relation(fields: [runId], references: [id])
  ruleId String @map("rule_id")
  rule   Rule   @relation(fields: [ruleId], references: [id])
  config Json? // rule-specific settings, e.g. an informational item-limit rule's count

  @@unique([runId, ruleId])
  @@map("run_rules")
}

model Run {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  gameId    String    @map("game_id")
  game      Game      @relation(fields: [gameId], references: [id])
  legacyId  String?   @map("legacy_id")
  legacy    Legacy?   @relation(fields: [legacyId], references: [id])
  status    RunStatus @default(ACTIVE)
  name      String?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  encounters       Encounter[]
  partyMemberships PartyMembership[]
  runRules         RunRule[]

  @@map("runs")
}

// Groups a chain of Runs on the same Game where a failed run hands off to a
// successor (with carried-over points and, by default, the same rules).
// Deliberately has no gameId of its own — every run in the chain shares one
// by construction, not by a denormalized/enforced field.
model Legacy {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  points    Int      @default(0) // denormalized cache of the sum of pointTransactions.amount
  createdAt DateTime @default(now()) @map("created_at")

  runs              Run[]
  pointTransactions LegacyPointTransaction[]

  @@map("legacies")
}

// Source-of-truth audit log backing Legacy.points. Point values per action
// aren't final yet, so a ledger keeps re-tuning them low-risk and makes
// "why do I have N points" answerable.
model LegacyPointTransaction {
  id        String   @id @default(uuid(7))
  legacyId  String   @map("legacy_id")
  legacy    Legacy   @relation(fields: [legacyId], references: [id])
  runId     String?  @map("run_id") // which run in the chain earned/spent it
  amount    Int // positive = earned, negative = spent
  reason    String // "catch", "gym-win", "rival-win", "reencounter", "resurrect"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("legacy_point_transactions")
}

enum VitalStatus {
  ALIVE
  DEAD

  @@map("vital_status")
}

// PENDING = not yet resolved (default). CAUGHT/MISSED are the two terminal
// outcomes of a route's one-shot wild encounter — MISSED covers however it
// went wrong (ran, fainted it, ran out of balls); the tracker doesn't
// distinguish which.
enum EncounterStatus {
  PENDING
  CAUGHT
  MISSED

  @@map("encounter_status")
}

// One row per encounter opportunity a user logs for a run. Usually one per
// route, but @@unique includes label so users can add extra ad hoc
// encounters to the same route (e.g. a static Snorlax tracked separately
// from the route's wild encounter).
model Encounter {
  id          String          @id @default(uuid(7))
  runId       String          @map("run_id")
  run         Run             @relation(fields: [runId], references: [id])
  routeId     String          @map("route_id")
  route       Route           @relation(fields: [routeId], references: [id])
  speciesId   String?         @map("species_id")
  species     Species?        @relation(fields: [speciesId], references: [id])
  label       String          @default("Wild Encounter")
  order       Float
  status      EncounterStatus @default(PENDING)
  nickname    String?
  vitalStatus VitalStatus?    @map("vital_status")
  lockedType  PokemonType?    @map("locked_type") // type-lock rule: chosen at catch time for dual-typed species, permanent thereafter
  createdAt   DateTime        @default(now()) @map("created_at")

  partyMembership PartyMembership?

  @@unique([runId, routeId, label])
  @@map("encounters")
}

// Existence of a row = the encounter's Pokemon is currently in the active
// party. Absence = boxed. Kept separate from Encounter so "what happened"
// (stable log) and "what's on my team right now" (frequently mutated) don't
// share a table.
model PartyMembership {
  id          String    @id @default(uuid(7))
  runId       String    @map("run_id")
  run         Run       @relation(fields: [runId], references: [id])
  encounterId String    @unique @map("encounter_id")
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("party_memberships")
}
